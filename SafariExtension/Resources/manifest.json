{
  "manifest_version": 3,
  "name": "Daisy DM",
  "version": "1.1",
  "description": "Intercepts Safari downloads and sends them directly to the Daisy Mac app — no dialogs.",
  "icons": {
    "16": "AppIcon16.png",
    "32": "AppIcon32.png",
    "48": "AppIcon48.png",
    "128": "AppIcon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": {
      "16": "AppIcon16.png",
      "32": "AppIcon32.png",
      "48": "AppIcon48.png",
      "128": "AppIcon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Dispatch Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "tabs",
    "cookies",
    "webRequest",
    "<all_urls>"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "AppIcon.png", "AppIcon16.png", "AppIcon32.png", "AppIcon48.png", "AppIcon128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  }
}
