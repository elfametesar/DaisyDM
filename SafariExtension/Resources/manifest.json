{
  "manifest_version": 3,
  "name": "Daisy DM",
  "version": "1.1",
  "description": "Intercepts Safari downloads and sends them directly to the Daisy Mac app — no dialogs.",
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dispatch Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "tabs",
    "cookies",
    "webRequest",
    "<all_urls>"
  ],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  }
}
