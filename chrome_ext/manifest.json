{
  "manifest_version": 3,
  "name": "Daisy DM",
  "version": "1.1",
  "description": "Intercepts downloads and sends them directly to the Daisy Mac app.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dispatch Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "tabs",
    "cookies",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"]
}
