{
  "manifest_version": 3,
  "name": "Daisy DM",
  "version": "1.1.0",
  "description": "Intercepts downloads and sends them directly to the Daisy Mac app.",
  "icons": {
    "16": "AppIcon16.png",
    "32": "AppIcon32.png",
    "48": "AppIcon48.png",
    "128": "AppIcon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "AppIcon16.png",
      "32": "AppIcon32.png",
      "48": "AppIcon48.png",
      "128": "AppIcon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Daisy DM Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "tabs",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "AppIcon.png",
        "AppIcon16.png",
        "AppIcon32.png",
        "AppIcon48.png",
        "AppIcon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
